OFILES_LD  = $(N64_INST)/build/n64sys.o
OFILES_LD += $(N64_INST)/build/interrupt.o
OFILES_LD += $(N64_INST)/build/inthandler.o
OFILES_LD += $(N64_INST)/build/entrypoint.o
OFILES_LD += $(N64_INST)/build/dragonfs.o
OFILES_LD += $(N64_INST)/build/audio.o
OFILES_LD += $(N64_INST)/build/display.o
OFILES_LD += $(N64_INST)/build/console.o
OFILES_LD += $(N64_INST)/build/controller.o
