OFILES_LDS  = $(N64_INST)/build/system.o

OFILES_LDP  = $(N64_INST)/build/n64sys.o
OFILES_LDP += $(N64_INST)/build/interrupt.o
OFILES_LDP += $(N64_INST)/build/inthandler.o
OFILES_LDP += $(N64_INST)/build/entrypoint_2.o
OFILES_LDP += $(N64_INST)/build/dragonfs.o
OFILES_LDP += $(N64_INST)/build/audio.o
OFILES_LDP += $(N64_INST)/build/display.o
OFILES_LDP += $(N64_INST)/build/console.o
OFILES_LDP += $(N64_INST)/build/controller.o
OFILES_LDP += $(N64_INST)/build/graphics.o
OFILES_LDP += $(N64_INST)/build/rdp.o
OFILES_LDP += $(N64_INST)/build/dma.o
OFILES_LDP += $(N64_INST)/build/timer.o
OFILES_LDP += $(N64_INST)/build/exception.o
OFILES_LDP += $(N64_INST)/build/do_ctors.o

# Rules for compiling system stuff
$(N64_INST)/build/n64sys.o: $(N64_INST)/src/n64sys.c
	mkdir -p $(N64_INST)/build
	$(CC) $(CFLAGS) -c -o $(N64_INST)/build/n64sys.o $(N64_INST)/src/n64sys.c
$(N64_INST)/build/interrupt.o: $(N64_INST)/src/interrupt.c
	mkdir -p $(N64_INST)/build
	$(CC) $(CFLAGS) -c -o $(N64_INST)/build/interrupt.o $(N64_INST)/src/interrupt.c
$(N64_INST)/build/dma.o: $(N64_INST)/src/dma.c
	mkdir -p $(N64_INST)/build
	$(CC) $(CFLAGS) -c -o $(N64_INST)/build/dma.o $(N64_INST)/src/dma.c
$(N64_INST)/build/inthandler.o: $(N64_INST)/src/inthandler.S
	mkdir -p $(N64_INST)/build
	$(CC) -c -o $(N64_INST)/build/inthandler.o $(N64_INST)/src/inthandler.S
$(N64_INST)/build/entrypoint.o: $(N64_INST)/src/entrypoint.S
	mkdir -p $(N64_INST)/build
	$(CC) -c -o $(N64_INST)/build/entrypoint.o $(N64_INST)/src/entrypoint.S

# Rules for compiling filesystem
$(N64_INST)/build/dragonfs.o: $(N64_INST)/src/dragonfs.c
	mkdir -p $(N64_INST)/build
	$(CC) $(CFLAGS) -c -o $(N64_INST)/build/dragonfs.o $(N64_INST)/src/dragonfs.c

